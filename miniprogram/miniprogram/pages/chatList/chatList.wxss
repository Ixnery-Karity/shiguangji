.list { background: #fff; }
.chat-item { display: flex; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #f2f2f2; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #e8f5e9; display: flex; align-items: center; justify-content: center; font-size: 44rpx; flex-shrink: 0; }
.c-main { flex: 1; margin-left: 20rpx; width: 0; }
.c-top { display: flex; justify-content: space-between; align-items: center; }
.c-name { font-size: 28rpx; font-weight: bold; color: #333; }
.c-time { font-size: 22rpx; color: #bbb; }
.c-msg { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.dot { min-width: 32rpx; height: 32rpx; padding: 0 8rpx; background: #e53935; color: #fff; font-size: 20rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; margin-left: 12rpx; }
