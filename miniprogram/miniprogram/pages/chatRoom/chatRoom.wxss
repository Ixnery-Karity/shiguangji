.page { display: flex; flex-direction: column; height: 100vh; background: #ededed; }

/* 商品条 */
.item-strip { display: flex; align-items: center; gap: 16rpx; background: #fff; padding: 16rpx 24rpx; border-bottom: 1rpx solid #eee; }
.item-strip .th { width: 72rpx; height: 72rpx; border-radius: 10rpx; background: linear-gradient(135deg,#dfe9e3,#c8e6c9); display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.i-main { flex: 1; width: 0; }
.i-title { font-size: 26rpx; color: #333; }
.i-price { color: #e53935; font-weight: bold; font-size: 30rpx; margin-top: 4rpx; }
.deal-btn { background: #2E7D32; color: #fff; font-size: 24rpx; padding: 12rpx 24rpx; border-radius: 28rpx; white-space: nowrap; }
.deal-btn.ongoing { background: #fff; color: #2E7D32; border: 1rpx solid #2E7D32; }

/* 消息 */
.msgs { flex: 1; padding: 24rpx; box-sizing: border-box; }
.sys { text-align: center; font-size: 20rpx; color: #999; background: rgba(0,0,0,.06); align-self: center; padding: 6rpx 20rpx; border-radius: 10rpx; margin: 16rpx auto; display: table; }
.msg-row { display: flex; margin-bottom: 24rpx; align-items: flex-start; }
.msg-row.me { flex-direction: row-reverse; }
.m-avatar { width: 64rpx; height: 64rpx; border-radius: 10rpx; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 34rpx; }
.bubble { max-width: 460rpx; padding: 18rpx 22rpx; border-radius: 12rpx; font-size: 28rpx; line-height: 1.45; margin: 0 16rpx; }
.b-them { background: #fff; }
.b-me { background: #95ec69; }

/* 交易卡片 */
.trade-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin: 16rpx 0; }
.tc-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }
.tc-row { display: flex; justify-content: space-between; font-size: 26rpx; color: #666; padding: 10rpx 0; }
.tc-v { color: #333; max-width: 420rpx; text-align: right; }
.tc-status { color: #ff9800; }
.tc-confirm { display: flex; gap: 16rpx; margin: 20rpx 0; }
.cc { flex: 1; text-align: center; font-size: 24rpx; color: #999; background: #f5f5f5; border-radius: 10rpx; padding: 16rpx 0; }
.cc.ok { background: #e8f5e9; color: #2E7D32; font-weight: bold; }
.tc-btn { background: #2E7D32; color: #fff; text-align: center; border-radius: 40rpx; padding: 22rpx 0; font-size: 28rpx; font-weight: bold; }
.tc-done { text-align: center; color: #2E7D32; font-size: 26rpx; padding: 16rpx 0; }

/* 输入栏 */
.input-bar { display: flex; align-items: center; gap: 16rpx; background: #f7f7f7; padding: 16rpx 24rpx; border-top: 1rpx solid #e5e5e5; }
.field { flex: 1; height: 68rpx; background: #fff; border-radius: 34rpx; padding: 0 28rpx; font-size: 28rpx; }
.send { background: #2E7D32; color: #fff; font-size: 26rpx; padding: 0 32rpx; height: 68rpx; line-height: 68rpx; border-radius: 34rpx; }
