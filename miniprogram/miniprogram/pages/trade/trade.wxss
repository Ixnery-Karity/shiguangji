.tabs { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab { flex: 1; text-align: center; padding: 28rpx 0; font-size: 28rpx; color: #666; position: relative; }
.tab.on { color: #2E7D32; font-weight: bold; }
.tab.on::after { content: ''; position: absolute; left: 50%; bottom: 10rpx; transform: translateX(-50%); width: 48rpx; height: 6rpx; background: #2E7D32; border-radius: 3rpx; }

.list { padding: 16rpx; }
.trade-item { display: flex; align-items: center; gap: 20rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.th { width: 100rpx; height: 100rpx; border-radius: 12rpx; background: linear-gradient(135deg,#dfe9e3,#c8e6c9); display: flex; align-items: center; justify-content: center; font-size: 48rpx; flex-shrink: 0; }
.t-main { flex: 1; width: 0; }
.t-title { font-size: 28rpx; color: #333; }
.t-meta { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.t-price { color: #e53935; font-weight: bold; font-size: 30rpx; margin-top: 8rpx; }
.t-status { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 16rpx; white-space: nowrap; }
.t-status.ing { color: #ff9800; background: #fff3e0; }
.t-status.done { color: #2E7D32; background: #e8f5e9; }
