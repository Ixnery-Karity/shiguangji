.page { padding-bottom: 130rpx; }

.gallery { height: 560rpx; }
.big-img {
  height: 560rpx; display: flex; align-items: center; justify-content: center;
  font-size: 200rpx; background: linear-gradient(135deg, #dfe9e3, #c8e6c9); color: #7cae86;
}

.price-block { background: #fff; padding: 24rpx; }
.price-block .row { display: flex; align-items: baseline; }
.price { color: #e53935; font-size: 52rpx; font-weight: bold; }
.price .sym { font-size: 28rpx; }
.origin { color: #999; font-size: 24rpx; text-decoration: line-through; margin-left: 16rpx; }
.title { font-size: 32rpx; color: #222; margin-top: 12rpx; line-height: 1.45; }
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.tag { font-size: 22rpx; background: #e8f5e9; color: #2E7D32; padding: 4rpx 16rpx; border-radius: 16rpx; }

.seller { display: flex; align-items: center; gap: 20rpx; background: #fff; padding: 24rpx; margin-top: 16rpx; }
.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: #2E7D32; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.s-name { font-size: 28rpx; font-weight: bold; }
.s-credit { margin-top: 6rpx; }

.locbox { display: flex; align-items: center; justify-content: space-between; background: #fff; padding: 24rpx; margin-top: 16rpx; font-size: 26rpx; color: #555; }
.locbox .guide { color: #2E7D32; font-size: 24rpx; }

.desc-block { background: #fff; padding: 24rpx; margin-top: 16rpx; }
.desc-block .dt { font-size: 26rpx; font-weight: bold; margin-bottom: 12rpx; }
.desc-block .dc { font-size: 26rpx; color: #666; line-height: 1.7; }

.safe-tip { margin: 16rpx 24rpx; font-size: 22rpx; color: #a1740b; background: #fff8e1; padding: 16rpx 20rpx; border-radius: 12rpx; line-height: 1.5; }

.views { margin-top: 12rpx; font-size: 22rpx; color: #999; }

/* 卖家在售 / 相关推荐（v0.4.0） */
.rec-block { background: #fff; padding: 24rpx 0 24rpx 24rpx; margin-top: 16rpx; }
.rec-block .dt { font-size: 26rpx; font-weight: bold; margin-bottom: 16rpx; }
.rec-scroll { white-space: nowrap; }
.rec-card {
  display: inline-block; width: 200rpx; margin-right: 16rpx;
  background: #fafafa; border-radius: 12rpx; overflow: hidden; vertical-align: top;
}
.rec-img {
  height: 160rpx; display: flex; align-items: center; justify-content: center;
  font-size: 80rpx; background: linear-gradient(135deg, #dfe9e3, #c8e6c9);
}
.rec-title { font-size: 22rpx; color: #333; padding: 8rpx 12rpx 0; }
.rec-price { font-size: 24rpx; color: #e53935; font-weight: bold; padding: 4rpx 12rpx 12rpx; }

.action-bar {
  position: fixed; bottom: 0; left: 0; right: 0; height: 110rpx;
  background: #fff; border-top: 1rpx solid #ececec;
  display: flex; align-items: center; padding: 0 20rpx; gap: 16rpx;
  box-sizing: border-box;
}
.action-bar .ic { display: flex; flex-direction: column; align-items: center; font-size: 20rpx; color: #888; width: 84rpx; }
.action-bar .ic .e { font-size: 34rpx; margin-bottom: 4rpx; }
.action-bar .btn { flex: 1; height: 76rpx; border-radius: 38rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; }
.btn-chat { background: #fff; border: 1rpx solid #2E7D32; color: #2E7D32; }
.btn-buy { background: #2E7D32; color: #fff; }
