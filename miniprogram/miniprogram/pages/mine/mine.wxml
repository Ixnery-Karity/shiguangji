<!-- 个人中心 -->
<view class="page">
  <!-- 头部 -->
  <view class="head">
    <view class="avatar">{{avatarText}}</view>
    <view class="h-info">
      <view class="nickname">{{nickname}}</view>
      <view class="vf {{authLevel>=2 ? 'on' : ''}}" bindtap="goAuth">
        {{authLevel>=2 ? '✔ 已认证学生' : (authLevel==1 ? '邮箱已验证 · 去完成认证' : '未认证 · 点此认证')}}
      </view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats">
    <view class="s"><view class="n">{{stat.onsale}}</view><view class="l">在售</view></view>
    <view class="s"><view class="n">{{stat.fav}}</view><view class="l">收藏</view></view>
    <view class="s"><view class="n">{{stat.done}}</view><view class="l">已成交</view></view>
    <view class="s"><view class="n">{{stat.rate}}</view><view class="l">好评率</view></view>
  </view>

  <!-- 菜单组1 -->
  <view class="menu">
    <view class="row" bindtap="goTrade"><text class="e">🤝</text><text class="t">我的交易</text><text class="ar">›</text></view>
    <view class="row" bindtap="goMyItems"><text class="e">📦</text><text class="t">我发布的</text><text class="ar">›</text></view>
    <view class="row" bindtap="goFavs"><text class="e">⭐</text><text class="t">我的收藏</text><text class="ar">›</text></view>
    <view class="row" bindtap="todo"><text class="e">🎫</text><text class="t">我的代金券</text><text class="ar">›</text></view>
  </view>

  <!-- 菜单组2 -->
  <view class="menu">
    <view class="row" bindtap="goAuth"><text class="e">🎓</text><text class="t">学生认证</text><text class="ar green">{{authLevel>=2 ? '已认证 ›' : '去认证 ›'}}</text></view>
    <view class="row" bindtap="todo"><text class="e">🗺️</text><text class="t">贡献导航路书（赚代金券）</text><text class="ar tag2">二期</text></view>
    <view class="row" bindtap="todo"><text class="e">🚩</text><text class="t">我的举报</text><text class="ar">›</text></view>
    <view class="row" bindtap="todo"><text class="e">⚙️</text><text class="t">设置</text><text class="ar">›</text></view>
  </view>

  <view class="ver">拾光集 v0.4.0 · 仅撮合线下当面交易</view>
</view>
