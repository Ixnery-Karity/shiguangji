.page { padding-bottom: 160rpx; }

/* 认证拦截条 */
.auth-guard {
  display: flex; align-items: center; gap: 16rpx;
  background: linear-gradient(135deg, #2E7D32, #1b5e20); color: #fff;
  padding: 24rpx; margin: 24rpx; border-radius: 16rpx;
}
.auth-guard .ico { font-size: 48rpx; }
.auth-guard .ag-title { font-size: 28rpx; font-weight: bold; }
.auth-guard .ag-sub { font-size: 22rpx; opacity: .9; margin-top: 4rpx; }
.auth-guard .ag-btn { margin-left: auto; background: rgba(255,255,255,.25); padding: 12rpx 28rpx; border-radius: 30rpx; font-size: 26rpx; }

.section { background: #fff; margin: 16rpx 0; padding: 8rpx 24rpx; }
.field { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f2f2f2; }
.field:last-child { border-bottom: none; }
.field.col { flex-direction: column; align-items: flex-start; }
.label { font-size: 26rpx; color: #333; width: 140rpx; flex-shrink: 0; }
.field.col .label { margin-bottom: 16rpx; }
.input { flex: 1; font-size: 28rpx; }
.price-input { color: #e53935; font-weight: bold; }
.unit { font-size: 26rpx; color: #999; }
.textarea { width: 100%; height: 160rpx; font-size: 28rpx; }

/* 图片 */
.imgs { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 24rpx 0; }
.img-box { width: 150rpx; height: 150rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; position: relative; }
.img-box.add { background: #f5f5f5; color: #bbb; font-size: 56rpx; border: 1rpx dashed #ddd; }
.img-box.filled { background: linear-gradient(135deg, #dfe9e3, #c8e6c9); color: #7cae86; }
.img-box .ph { font-size: 48rpx; }
.img-box .del { position: absolute; top: -12rpx; right: -12rpx; width: 36rpx; height: 36rpx; background: rgba(0,0,0,.6); color: #fff; border-radius: 50%; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }

/* 芯片 */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { font-size: 24rpx; padding: 10rpx 28rpx; border-radius: 28rpx; background: #f0f0f0; color: #666; }
.chip.on { background: #2E7D32; color: #fff; }

.submit-wrap { padding: 32rpx 24rpx; }
